# =========================================================
# SecureCode AI - Environment Configuration Template
# =========================================================

# Database Connection (MySQL)
# Format: dialect+driver://username:password@localhost:3306/database_name
DATABASE_URL=
TEST_DATABASE_URL=

# OpenRouter / LLM Configuration
# OPENROUTER_API_KEY=your_api_key_here

# JWT Authentication Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Application URL (for password reset links)
# Production: https://buddhadeb-pan.github.io/SecureCode-AI
# Local development: http://localhost:5173
FRONTEND_URL=https://your-frontend-domain.example

# CORS Configuration (comma-separated production origins)
CORS_ALLOWED_ORIGINS=https://buddhadeb-pan.github.io

# Password Reset Token Expiry (minutes)
PASSWORD_RESET_EXPIRE_MINUTES=20

# Brevo HTTPS Transactional Email API (Production - Render Free)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=your_verified_sender@example.com

# Brevo SMTP Configuration (Local Development Fallback - port 587)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_account_login_or_smtp_user
SMTP_PASSWORD=your_brevo_smtp_key_or_password

